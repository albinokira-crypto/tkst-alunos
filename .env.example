# TKST Alunos — Variáveis de Ambiente
# Copie este arquivo para .env.local para desenvolvimento local.
# Na Vercel, configure via: Settings > Environment Variables

# ============================================================
# GITHUB_TOKEN — Personal Access Token para auto-commit
# ============================================================
# Como criar:
# 1. Acesse: https://github.com/settings/tokens/new
# 2. Note name: "TKST Auto-Commit Quiz"
# 3. Expiration: No expiration (ou 1 year)
# 4. Scopes: marque apenas "repo" > "Contents" (write)
# 5. Clique em "Generate token" e copie o valor
#
# Na Vercel:
# Settings > Environment Variables > Add:
#   Name:  GITHUB_TOKEN
#   Value: ghp_xxxxxxxxxxxxxxxxxxx
#   Environment: Production + Preview + Development
GITHUB_TOKEN=

# GITHUB_REPO — Repositório alvo (owner/nome-do-repo)
# Padrão já configurado: albinokira-crypto/tkst-alunos
# Só mude se renomear ou mover o repositório.
GITHUB_REPO=albinokira-crypto/tkst-alunos

# GITHUB_BRANCH — Branch alvo para os commits automáticos
# Padrão: main
GITHUB_BRANCH=main
